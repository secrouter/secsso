# SecSSO (Authentik) — copy to .env and fill in. Generate the secrets:
#   openssl rand -base64 60 | tr -d '\n'   → AUTHENTIK_SECRET_KEY
#   openssl rand -base64 36 | tr -d '\n'   → PG_PASS
#   openssl rand -base64 36 | tr -d '\n'   → AUTHENTIK_BOOTSTRAP_TOKEN  (API token for the CLI)

# Pin to the current stable Authentik release (see https://goauthentik.io/docs/releases).
AUTHENTIK_TAG=2024.12
AUTHENTIK_IMAGE=ghcr.io/goauthentik/server

# Core secrets (required)
AUTHENTIK_SECRET_KEY=
PG_PASS=

# Postgres identity
PG_USER=authentik
PG_DB=authentik

# Initial admin (akadmin). Set a strong password and an API token so `secsso.sh`
# can read back the wired OIDC clients.
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_BOOTSTRAP_TOKEN=
AUTHENTIK_BOOTSTRAP_EMAIL=admin@secrouter.local

# Where clients (and the OIDC issuer) reach SecSSO. Must match the redirect URIs
# configured in the blueprints. Use https:// behind a TLS proxy in production.
SECSSO_EXTERNAL_URL=http://localhost:9000
SECSSO_HTTP_PORT=9000
SECSSO_HTTPS_PORT=9443

# The suite services SecSSO wires OIDC apps for (used by blueprints/bootstrap).
SECROUTER_REDIRECT_URI=http://localhost:18800/admin/callback
