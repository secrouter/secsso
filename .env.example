# SecSSO (Authentik) — copy to .env and fill in. Generate the secrets:
#   openssl rand -base64 60 | tr -d '\n'   → AUTHENTIK_SECRET_KEY
#   openssl rand -base64 36 | tr -d '\n'   → PG_PASS
#   openssl rand -base64 36 | tr -d '\n'   → AUTHENTIK_BOOTSTRAP_TOKEN  (API token for the CLI)

# Pin to the current stable Authentik release (see https://goauthentik.io/docs/releases).
AUTHENTIK_TAG=2024.12
AUTHENTIK_IMAGE=ghcr.io/goauthentik/server

# Core secrets (required)
AUTHENTIK_SECRET_KEY=
PG_PASS=

# Postgres identity
PG_USER=authentik
PG_DB=authentik

# Initial admin (akadmin). Set a strong password and an API token so `secsso.sh`
# can read back the wired OIDC clients.
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_BOOTSTRAP_TOKEN=
AUTHENTIK_BOOTSTRAP_EMAIL=admin@secrouter.local

# Where clients (and the OIDC issuer) reach SecSSO. Must match the redirect URIs
# configured in the blueprints. Use https:// behind a TLS proxy in production.
SECSSO_EXTERNAL_URL=http://localhost:9000
SECSSO_HTTP_PORT=9000
SECSSO_HTTPS_PORT=9443

# The suite services SecSSO wires OIDC apps for (used by blueprints/bootstrap).
SECROUTER_REDIRECT_URI=http://localhost:18800/admin/callback

# secagent's confidential (client_credentials) service client — see blueprints/
# secagent-service.yaml. Blank generates a strong random value on first deploy (same
# auto-generate-if-blank convention as AUTHENTIK_SECRET_KEY/PG_PASS above); secdeploy reads
# this back and mirrors it into secagent's own SECAGENT_CLIENT_SECRET so the two agree.
SECAGENT_SERVICE_CLIENT_SECRET=

# SecAgent — pi CLI's optional local-loopback PKCE redirect. The primary login path
# (`secagent login`, device-code — see blueprints/secagent-pi.yaml) never uses this;
# only needed if pi drives a browser-based login itself.
SECAGENT_PI_REDIRECT_URI=http://localhost:8765/callback

# SecChat (native — SecSSO OIDC client id secchatng) — see blueprints/secchatng.yaml. ONE
# confidential login client: the backend runs the Authorization Code + PKCE dance itself
# (server-side BFF, httpOnly session cookie — no separate client_credentials service account
# needed). Blank auto-generates on first deploy; secdeploy mirrors this
# into secchatng's own SECCHAT_OIDC_CLIENT_SECRET so the two agree.
SECCHATNG_OIDC_CLIENT_SECRET=
# Where SecChat (native) runs (OIDC redirect + user-portal launch tile).
SECCHATNG_REDIRECT_URI=https://secchatng.sec.internal/auth/callback
SECCHATNG_LAUNCH_URL=https://secchatng.sec.internal

# SecRecorder (transcription — SecSSO OIDC client id secrecorder) — see blueprints/
# secrecorder.yaml. ONE confidential login client for its optional browser-login BFF (the
# backend runs the Authorization Code + PKCE dance itself, server-side, httpOnly session cookie
# — no separate client_credentials service account needed). A brand-new client, so its id and
# slug are plainly "secrecorder". Blank auto-generates on first deploy; secdeploy mirrors this
# into SecRecorder's own SECRECORDER_OIDC_CLIENT_SECRET so the two agree.
SECRECORDER_OIDC_CLIENT_SECRET=
# Where SecRecorder runs (OIDC redirect + user-portal launch tile).
SECRECORDER_REDIRECT_URI=https://secrecorder.sec.internal/auth/callback
SECRECORDER_LAUNCH_URL=https://secrecorder.sec.internal

# SecChat's shared service identity (client_credentials, client id secchat-service) — see
# blueprints/secchat-service.yaml. ONE identity for all SecChat's SecRouter traffic (assistant
# path + pi, which reuses SecChat's own token). Two blank-generated values:
#   SECCHAT_SERVICE_PROVIDER_SECRET — the confidential provider's own client_secret. Dead weight
#     required only by the blueprint schema — SecChat does NOT send this as-is; see the
#     blueprint header for why.
#   SECCHAT_SVC_APP_PASSWORD — the app-password Token key bound to the pre-provisioned
#     "svc-secchat" service-account user. The SecChat-auth wiring step must read this back and
#     set SecChat's own SECCHAT_SECROUTER_CLIENT_SECRET to
#     base64("svc-secchat:" + SECCHAT_SVC_APP_PASSWORD) — NOT a fresh random value — for
#     SecChat's client_credentials grant to actually resolve to sub="svc-secchat" (see the
#     blueprint header for the full mechanism, verified against Authentik 2024.12 source).
SECCHAT_SERVICE_PROVIDER_SECRET=
SECCHAT_SVC_APP_PASSWORD=

# SecRouter admin console — OIDC PKCE public client (client id secrouter-admin-console) for a
# human logging into the console. See blueprints/secrouter-admin-console.yaml. Distinct from
# SECROUTER_REDIRECT_URI above, which is secrouter-oidc.yaml's own PKCE client.
SECROUTER_ADMIN_CONSOLE_REDIRECT_URI=https://secrouter.sec.internal/admin
SECROUTER_ADMIN_CONSOLE_LAUNCH_URL=https://secrouter.sec.internal/admin

# SecLLM (inference control plane — SecSSO OIDC client id secllm) — see blueprints/secllm.yaml.
# Gates SecLLM's ADMIN console only (not inference; the SecRouter↔SecLLM link keeps its shared
# token). ONE confidential login client for its optional admin BFF (server-side Authorization Code
# + PKCE, httpOnly session cookie). A brand-new client, so its id and slug are plainly "secllm".
# Blank auto-generates on first deploy; secdeploy mirrors this into SecLLM's own
# SECLLM_OIDC_CLIENT_SECRET so the two agree. The blueprint also provisions the `secllm-admins`
# group — add operators to it to grant SecLLM admin.
SECLLM_OIDC_CLIENT_SECRET=
# Where SecLLM's admin console runs (OIDC redirect + user-portal launch tile → /admin).
SECLLM_REDIRECT_URI=https://secllm.sec.internal/auth/callback
SECLLM_LAUNCH_URL=https://secllm.sec.internal/admin
